# Runs wolverine as a hardened system service.
#
# Installed by "sudo make install" (see the Makefile), then:
#   systemctl enable --now wolverine
#
# The sources of the configuration must use "follow: true": otherwise
# wolverine reads them once and the service stops.

[Unit]
Description=Wolverine log analyzer
Documentation=file:///etc/wolverine/wolverine.yaml
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/wolverine -config /etc/wolverine/wolverine.yaml
# Secrets referenced by the configuration (smtp.password_env,
# webhook.url_env, webhook.headers_env...). Optional.
EnvironmentFile=-/etc/wolverine/wolverine.env

# SIGTERM stops wolverine cleanly: queued actions run and the positions of
# the sources are saved. Leave time for webhook retries and slow SMTP servers.
TimeoutStopSec=60
Restart=on-failure
RestartSec=10s

User=wolverine
Group=wolverine
# Reading the system journal (systemd-service sources).
SupplementaryGroups=systemd-journal
# Reading root-only log files such as /var/log/messages (logfile sources),
# without running as root. Remove it if the log files are readable by the
# wolverine user (e.g. with ACLs or a dedicated group).
AmbientCapabilities=CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_DAC_READ_SEARCH

# /var/lib/wolverine: state_file (positions of the sources). Also the home of
# the wolverine user, for the ssh action: put its key and known_hosts in
# /var/lib/wolverine/.ssh/.
StateDirectory=wolverine
StateDirectoryMode=0700
UMask=0077

# Hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
