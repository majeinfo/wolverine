# Secrets for wolverine, read by the service from /etc/wolverine/wolverine.env.
# Install with:  install -m 0600 -o root -g root wolverine.env.example /etc/wolverine/wolverine.env
# The names must match the *_env settings of /etc/wolverine/wolverine.yaml.

# smtp.password_env
#WOLVERINE_SMTP_PASSWORD=

# webhook.headers_env (action "webhook")
#WOLVERINE_WEBHOOK_TOKEN=Bearer xxxxxxxx

# webhook.url_env (action "slack")
#WOLVERINE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
